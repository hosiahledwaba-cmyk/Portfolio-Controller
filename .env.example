# Admin Secret Passcode (used to authorize updates to your portfolio)
ADMIN_SECRET=your_super_secret_admin_passcode

# Optional: Upstash Redis / Vercel KV for permanent cloud storage across Vercel free tier instances
# If omitted, uses local JSON/in-memory storage automatically!
# Obtain for free from https://console.upstash.com or Vercel Storage Marketplace (free tier: 10,000 commands/day)
KV_REST_API_URL=https://your-upstash-instance.upstash.io
KV_REST_API_TOKEN=your_upstash_rest_token
